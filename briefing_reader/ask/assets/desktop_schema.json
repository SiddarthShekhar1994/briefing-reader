{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisDesktopPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["say", "steps"],
  "properties": {
    "say": {
      "type": "string",
      "maxLength": 200,
      "description": "One short sentence on what you lined up. Never claim anything is done or opened."
    },
    "question": {
      "type": "string",
      "maxLength": 200,
      "description": "One short question when the request is unclear; then give no steps."
    },
    "steps": {
      "type": "array",
      "maxItems": 12,
      "description": "At most 12 steps, in order; each with only its skill's fields.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "why"],
        "properties": {
          "skill": {
            "type": "string",
            "enum": ["find_files", "open_file", "show_in_folder", "open_folder", "open_app", "open_url"]
          },
          "why": {"type": "string", "maxLength": 120, "description": "A few words: why this step."},
          "files": {
            "type": "array",
            "maxItems": 200,
            "items": {"type": "string", "pattern": "^f[0-9]{1,4}$"},
            "description": "open_file and show_in_folder: exactly one f id from <files>."
          },
          "place": {"type": "string", "pattern": "^d[0-9]{1,3}$", "description": "A d id from <places>."},
          "query": {"type": "string", "maxLength": 120, "description": "find_files: the words to look for."},
          "kind": {"type": "string", "enum": ["document", "picture", "music", "video", "folder", "any"]},
          "within_days": {"type": "integer", "minimum": 1, "maximum": 365},
          "app": {"type": "string", "pattern": "^a[0-9]{1,3}$", "description": "An a id from <apps>."},
          "site": {"type": "string", "pattern": "^s[0-9]{1,2}$", "description": "An s id from <sites>."},
          "url": {
            "type": "string",
            "maxLength": 2000,
            "description": "open_url: a web address starting with https that the owner typed word for word."
          }
        }
      }
    }
  }
}
